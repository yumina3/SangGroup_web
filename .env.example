# --- Supabase (wajib, sesuai SRS BR-03) ---------------------------------
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://xxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJ..."

# HANYA untuk server: membuat akun staf (seed/admin) & unggah foto.
# Jangan pernah memakai prefix NEXT_PUBLIC_ untuk kunci ini.
SUPABASE_SERVICE_ROLE_KEY="eyJ..."

# Database Postgres Supabase (Project Settings → Database → Connection string).
# Gunakan Direct connection atau Session pooler untuk migrasi.
DATABASE_URL="postgresql://postgres:PASSWORD@db.xxxx.supabase.co:5432/postgres?sslmode=require"

# Bucket foto properti (buat di Supabase Storage, set Public).
SUPABASE_STORAGE_BUCKET="property-images"

# --- Redis & Web Push (wajib untuk notifikasi) --------------------------
REDIS_URL="redis://localhost:6379"

# Buat: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@sanggroup.id"

# --- Aplikasi -----------------------------------------------------------
# trace | debug | info | warn | error
LOG_LEVEL="info"
