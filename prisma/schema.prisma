generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --- Modul identity -----------------------------------------------------
// Mengikuti SRS §8 dan skema Supabase yang sudah berjalan:
// profiles(id, full_name, phone, role, is_active, created_at, updated_at).
// Email dan metadata agen disimpan di auth.users; lapisan aplikasi membacanya
// lewat join di src/lib/auth/profile.js. Jangan menambah kolom duplikat di
// sini tanpa migrasi yang disepakati.

enum UserRole {
  buyer
  agent
  admin
}

/// Profil aplikasi. `id` sama dengan `auth.users.id` pada Supabase Auth.
model Profile {
  id        String   @id @db.Uuid
  fullName  String   @map("full_name")
  phone     String?
  role      UserRole @default(buyer)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("profiles")
}
